{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "llm-wiki-compiler": ["./src/index.ts"],
      "llmwiki-dev-backend": ["./packages/llmwiki-dev-backend/src/index.ts"],
      "llmwiki-limited-isolation-backend": ["./packages/llmwiki-limited-isolation-backend/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
