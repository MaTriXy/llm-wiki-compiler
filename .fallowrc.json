{
  "$schema": "https://fallow.tools/schema.json",
  "entry": [
    "src/viewer/assets/viewer.js",
    "scripts/copy-viewer-assets.mjs",
    "src/viewer/assets/viewer-theme-boot.js",
    "test/fixtures/mock-embeddings.mjs",
    "test/fixtures/track-dotenv-read.mjs"
  ],
  "ignorePatterns": [
    "docs/**",
    "src/viewer/assets/index.html",
    "src/viewer/assets/viewer-content.css",
    "src/viewer/assets/viewer-tokens.css",
    "src/viewer/assets/viewer-chrome.css",
    "src/viewer/assets/viewer-dashboard.css",
    "src/viewer/assets/viewer-health.css",
    "src/viewer/assets/viewer-pipeline.css",
    "src/viewer/assets/viewer-graph.css",
    "src/viewer/assets/viewer-material.css"
  ],
  "ignoreDependencies": [
    "@fontsource/dm-sans",
    "@fontsource/nunito",
    "@fontsource/space-grotesk",
    "@fontsource/jetbrains-mono"
  ],
  "ignoreExports": [
    { "file": "src/utils/output.ts", "exports": ["getQuiet"] },
    { "file": "src/preparations/orphan-scan.ts", "exports": ["scanPreparationOrphans"] },
    { "file": "src/capability-providers/runtime/result-admission.ts", "exports": ["EvidenceRefV1"] },
    { "file": "src/operation-bundles/manifest-store.ts", "exports": ["ManifestCreateResult"] },
    { "file": "src/operation-bundles/stage.ts", "exports": ["StageFaultsForTest"] },
    { "file": "src/operation-bundles/run-store.ts", "exports": ["appendAbandonedTransitionLocked"] },
    { "file": "test/preparation-recovery-fixture.ts", "exports": ["readRun"] },
    { "file": "test/preparations/cancel-settlement-fixture.ts", "exports": ["readRun"] }
  ],
  "overrides": [
    {
      "files": ["src/providers/*.ts", "src/utils/provider-guard.ts"],
      "rules": {
        "unused-class-members": "off"
      }
    }
  ]
}
